{
  "name": "alumbus",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "run:a": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "open": "npm start --reset-cache",
    "clean:android": "cd android && ./gradlew clean && cd -",
    "clean:cache": "cd android && ./gradlew cleanBuildCache && cd -",
    "clean:ios": "cd ios && xcodebuild clean && cd -",
    "copy:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "assemble:android": "cd android && ./gradlew clean && ./gradlew assembledebug",
    "build:ios": "react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios'"
  },
  "dependencies": {
    "@react-native-community/async-storage": "^1.12.1",
    "@react-native-community/blur": "^3.6.0",
    "@react-native-community/datetimepicker": "^3.0.9",
    "@react-native-community/masked-view": "^0.1.10",
    "@react-native-community/netinfo": "^5.9.9",
    "@react-native-community/progress-bar-android": "^1.0.4",
    "@react-native-community/progress-view": "^1.2.3",
    "@react-native-community/viewpager": "^4.2.2",
    "@react-navigation/native": "^5.8.10",
    "@react-navigation/stack": "^5.12.8",
    "axios": "^0.21.1",
    "moment": "^2.29.1",
    "native-base": "^2.15.0",
    "react": "16.13.1",
    "react-native": "0.63.4",
    "react-native-af-video-player": "^0.2.1",
    "react-native-app-intro-slider": "^4.0.4",
    "react-native-check-box": "^2.1.7",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-date-picker": "^3.2.10",
    "react-native-device-info": "^7.3.1",
    "react-native-document-picker": "^4.3.0",
    "react-native-elements": "^3.1.0",
    "react-native-fast-image": "^8.3.4",
    "react-native-gesture-handler": "^1.9.0",
    "react-native-image-crop-picker": "^0.35.3",
    "react-native-image-picker": "^3.1.4",
    "react-native-image-progress": "^1.1.1",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-iphone-x-helper": "^1.3.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.3",
    "react-native-linear-gradient": "^2.5.6",
    "react-native-pdf": "^6.2.2",
    "react-native-progress": "^4.1.2",
    "react-native-raw-bottom-sheet": "^2.2.0",
    "react-native-reanimated": "^1.13.2",
    "react-native-render-html": "^5.1.0",
    "react-native-safe-area-context": "^3.1.9",
    "react-native-screens": "^2.16.1",
    "react-native-scrollable-tab-view": "^1.0.0",
    "react-native-share": "^5.1.1",
    "react-native-splash-screen": "^3.2.0",
    "react-native-swipe-gestures": "^1.0.5",
    "react-native-underline-tabbar": "^1.3.6",
    "react-native-vector-icons": "^7.1.0",
    "react-native-video": "^5.1.0-alpha8",
    "react-native-webview": "^11.2.1",
    "react-native-youtube": "^2.0.1",
    "rn-fetch-blob": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/runtime": "^7.12.5",
    "@react-native-community/eslint-config": "^2.0.0",
    "babel-jest": "^26.6.3",
    "eslint": "^7.17.0",
    "jest": "^26.6.3",
    "metro-react-native-babel-preset": "^0.64.0",
    "react-native-bundle-visualizer": "^2.2.1",
    "react-test-renderer": "16.13.1"
  },
  "jest": {
    "preset": "react-native"
  }
}
